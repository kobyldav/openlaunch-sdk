{
  "name": "openlaunch-sdk",
  "version": "1.1.0",
  "description": "Backwards-compatible OpenLaunch umbrella SDK plus six independently installable domain workspaces.",
  "keywords": [
    "space",
    "spaceflight",
    "rocket",
    "launch",
    "mars",
    "orbital-mechanics",
    "nasa",
    "celestrak",
    "launch-library",
    "mission",
    "typescript",
    "sdk",
    "earth-observation",
    "stac",
    "sentinel",
    "landsat",
    "copernicus",
    "geospatial",
    "remote-sensing",
    "open-meteo",
    "sgp4",
    "sdp4",
    "satellite-tracking",
    "satellite-pass",
    "ground-track",
    "space-traffic",
    "conjunction",
    "ssa",
    "space-situational-awareness",
    "launch-simulation",
    "3dof",
    "trajectory",
    "runge-kutta",
    "aerodynamics",
    "monte-carlo",
    "mission-planning",
    "satellite-imagery",
    "raster-assets",
    "earth-surface-temperature",
    "orbit-targeting",
    "targeting-sweep",
    "geotiff",
    "cog",
    "raster",
    "ndvi",
    "terrain-mesh",
    "change-detection"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist-cjs/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist-cjs/index.js"
    },
    "./science": {
      "types": "./dist/science/index.d.ts",
      "import": "./dist/science/index.js",
      "require": "./dist-cjs/science/index.js"
    },
    "./providers": {
      "types": "./dist/providers/index.d.ts",
      "import": "./dist/providers/index.js",
      "require": "./dist-cjs/providers/index.js"
    },
    "./geo": {
      "types": "./dist/geo/index.d.ts",
      "import": "./dist/geo/index.js",
      "require": "./dist-cjs/geo/index.js"
    },
    "./eo": {
      "types": "./dist/eo/index.d.ts",
      "import": "./dist/eo/index.js",
      "require": "./dist-cjs/eo/index.js"
    },
    "./intelligence": {
      "types": "./dist/intelligence/index.d.ts",
      "import": "./dist/intelligence/index.js",
      "require": "./dist-cjs/intelligence/index.js"
    },
    "./orbit": {
      "types": "./dist/orbit/index.d.ts",
      "import": "./dist/orbit/index.js",
      "require": "./dist-cjs/orbit/index.js"
    },
    "./traffic": {
      "types": "./dist/traffic/index.d.ts",
      "import": "./dist/traffic/index.js",
      "require": "./dist-cjs/traffic/index.js"
    },
    "./sensors": {
      "types": "./dist/sensors/index.d.ts",
      "import": "./dist/sensors/index.js",
      "require": "./dist-cjs/sensors/index.js"
    },
    "./scenario": {
      "types": "./dist/scenario/index.d.ts",
      "import": "./dist/scenario/index.js",
      "require": "./dist-cjs/scenario/index.js"
    },
    "./trajectory": {
      "types": "./dist/trajectory/index.d.ts",
      "import": "./dist/trajectory/index.js",
      "require": "./dist-cjs/trajectory/index.js"
    },
    "./mission": {
      "types": "./dist/mission/index.d.ts",
      "import": "./dist/mission/index.js",
      "require": "./dist-cjs/mission/index.js"
    }
  },
  "files": [
    "dist",
    "dist-cjs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs",
    "examples",
    "llms.txt"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node scripts/finalize-cjs.mjs && node scripts/build-workspaces.mjs",
    "test": "npm run build && node --test tests/*.test.mjs && node scripts/cjs-smoke.cjs && node scripts/launch-trajectory-demo.mjs && node scripts/mission-intelligence-demo.mjs && node scripts/geospatial-raster-demo.mjs && npm run test:packages",
    "test:live": "npm run build && node scripts/live-smoke.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run typecheck && npm run examples:check && npm test",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm run check && npm run pack:check && npm run pack:check:packages && npm run test:packed",
    "examples:check": "tsc -p tsconfig.examples.json --noEmit",
    "test:earth-live": "npm run build && node scripts/earth-live-smoke.mjs",
    "example:rotterdam": "npm run build && node scripts/rotterdam-monitor.mjs",
    "example:orbit-traffic": "npm run build && node scripts/orbit-traffic-demo.mjs",
    "example:launch": "npm run build && node scripts/launch-trajectory-demo.mjs",
    "test:launch-offline": "npm run build && node scripts/launch-trajectory-demo.mjs",
    "example:mission": "npm run build && node scripts/mission-intelligence-demo.mjs",
    "example:raster": "npm run build && node scripts/geospatial-raster-demo.mjs",
    "build:packages": "node scripts/build-workspaces.mjs",
    "test:packages": "npm run typecheck:packages && node --test tests/packages.test.mjs",
    "pack:check:packages": "node scripts/pack-workspaces.mjs",
    "typecheck:packages": "tsc -p tsconfig.workspaces.json --noEmit",
    "test:packed": "node scripts/test-packed-consumers.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "satellite.js": "6.0.2"
  },
  "workspaces": [
    "packages/*"
  ]
}
