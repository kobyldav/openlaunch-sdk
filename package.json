{
  "name": "openlaunch-sdk",
  "version": "0.7.0",
  "description": "A TypeScript space computation SDK for launch data, SGP4/SDP4 satellite tracking, space-traffic geometry, Earth observation, geospatial intelligence and mission engineering.",
  "keywords": [
    "space",
    "spaceflight",
    "rocket",
    "launch",
    "mars",
    "orbital-mechanics",
    "nasa",
    "celestrak",
    "launch-library",
    "mission",
    "typescript",
    "sdk",
    "earth-observation",
    "stac",
    "sentinel",
    "landsat",
    "copernicus",
    "geospatial",
    "remote-sensing",
    "open-meteo",
    "sgp4",
    "sdp4",
    "satellite-tracking",
    "satellite-pass",
    "ground-track",
    "space-traffic",
    "conjunction",
    "ssa",
    "space-situational-awareness"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist-cjs/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist-cjs/index.js"
    },
    "./science": {
      "types": "./dist/science/index.d.ts",
      "import": "./dist/science/index.js",
      "require": "./dist-cjs/science/index.js"
    },
    "./providers": {
      "types": "./dist/providers/index.d.ts",
      "import": "./dist/providers/index.js",
      "require": "./dist-cjs/providers/index.js"
    },
    "./geo": {
      "types": "./dist/geo/index.d.ts",
      "import": "./dist/geo/index.js",
      "require": "./dist-cjs/geo/index.js"
    },
    "./eo": {
      "types": "./dist/eo/index.d.ts",
      "import": "./dist/eo/index.js",
      "require": "./dist-cjs/eo/index.js"
    },
    "./intelligence": {
      "types": "./dist/intelligence/index.d.ts",
      "import": "./dist/intelligence/index.js",
      "require": "./dist-cjs/intelligence/index.js"
    },
    "./orbit": {
      "types": "./dist/orbit/index.d.ts",
      "import": "./dist/orbit/index.js",
      "require": "./dist-cjs/orbit/index.js"
    },
    "./traffic": {
      "types": "./dist/traffic/index.d.ts",
      "import": "./dist/traffic/index.js",
      "require": "./dist-cjs/traffic/index.js"
    },
    "./sensors": {
      "types": "./dist/sensors/index.d.ts",
      "import": "./dist/sensors/index.js",
      "require": "./dist-cjs/sensors/index.js"
    },
    "./scenario": {
      "types": "./dist/scenario/index.d.ts",
      "import": "./dist/scenario/index.js",
      "require": "./dist-cjs/scenario/index.js"
    }
  },
  "files": [
    "dist",
    "dist-cjs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs",
    "examples",
    "llms.txt"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node scripts/finalize-cjs.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:live": "npm run build && node scripts/live-smoke.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run typecheck && npm run examples:check && npm test",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm run check && npm run pack:check",
    "examples:check": "tsc -p tsconfig.examples.json --noEmit",
    "test:earth-live": "npm run build && node scripts/earth-live-smoke.mjs",
    "example:rotterdam": "npm run build && node scripts/rotterdam-monitor.mjs",
    "example:orbit-traffic": "npm run build && node scripts/orbit-traffic-demo.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "satellite.js": "6.0.2"
  }
}
