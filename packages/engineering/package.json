{
  "name": "@openlaunchsdk/engineering",
  "version": "1.22.1",
  "description": "Spacecraft physics, rocket trajectory, control, mission math and target-orbit studies",
  "license": "MIT",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./internal/*": {
      "types": "./dist/types/*.d.ts",
      "import": "./dist/esm/*.js",
      "require": "./dist/cjs/*.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@openlaunchsdk/core": "^1.22.1",
    "@openlaunchsdk/orbit": "^1.22.1",
    "@openlaunchsdk/math": "^1.22.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kobyldav/openlaunch-sdk.git",
    "directory": "packages/engineering"
  },
  "homepage": "https://github.com/kobyldav/openlaunch-sdk/tree/main/packages/engineering#readme",
  "bugs": {
    "url": "https://github.com/kobyldav/openlaunch-sdk/issues"
  },
  "keywords": [
    "rocket",
    "trajectory",
    "spacecraft",
    "mission-planning",
    "aerospace"
  ],
  "publishConfig": {
    "access": "public"
  }
}
