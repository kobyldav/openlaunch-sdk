{
  "name": "@openlaunchsdk/math",
  "version": "1.22.1",
  "description": "Independent vectors, matrices, quaternions, numerics, statistics, units and control math",
  "license": "MIT",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./internal/*": {
      "types": "./dist/types/*.d.ts",
      "import": "./dist/esm/*.js",
      "require": "./dist/cjs/*.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@openlaunchsdk/core": "^1.22.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kobyldav/openlaunch-sdk.git",
    "directory": "packages/math"
  },
  "homepage": "https://github.com/kobyldav/openlaunch-sdk/tree/main/packages/math#readme",
  "bugs": {
    "url": "https://github.com/kobyldav/openlaunch-sdk/issues"
  },
  "keywords": [
    "math",
    "vector",
    "matrix",
    "quaternion",
    "kalman-filter",
    "numerics"
  ],
  "publishConfig": {
    "access": "public"
  }
}
