{
  "name": "@openlaunchsdk/orbit",
  "version": "1.22.1",
  "description": "SGP4/SDP4 propagation, satellite passes, traffic screening and observation geometry",
  "license": "MIT",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./internal/*": {
      "types": "./dist/types/*.d.ts",
      "import": "./dist/esm/*.js",
      "require": "./dist/cjs/*.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@openlaunchsdk/core": "^1.22.1",
    "satellite.js": "6.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kobyldav/openlaunch-sdk.git",
    "directory": "packages/orbit"
  },
  "homepage": "https://github.com/kobyldav/openlaunch-sdk/tree/main/packages/orbit#readme",
  "bugs": {
    "url": "https://github.com/kobyldav/openlaunch-sdk/issues"
  },
  "keywords": [
    "orbit",
    "sgp4",
    "satellite-tracking",
    "ground-pass",
    "space-traffic"
  ],
  "publishConfig": {
    "access": "public"
  }
}
